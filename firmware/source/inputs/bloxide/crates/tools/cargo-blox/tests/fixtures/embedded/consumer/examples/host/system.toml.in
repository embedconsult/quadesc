[system]
name = "fixture-host"
runtime = "embassy"
[platform]
impl_crate = "fixture_platform"
entry = "hosted"
init = "initialize"
on_error = "startup_failed"
freeze = "freeze"
resources = "Resources"
cleanup = "process-lifetime"
[[services]]
name = "led_io"
impl_crate = "fixture_platform"
start = "start_led"
resource = "led_service"
[[actors]]
name = "lamp"
blox = "lamp::lamp"
channel_capacity = 2
[actors.inject]
output = { source = "resource", field = "led_output" }
