/begin IF_DATA XCP
/begin PROTOCOL_LAYER
0x0100
5000 5000 5000 5000 5000 5000 5000
8 8 BYTE_ORDER_MSB_LAST ADDRESS_GRANULARITY_BYTE
OPTIONAL_CMD SET_REQUEST
OPTIONAL_CMD SET_MTA
OPTIONAL_CMD UPLOAD
OPTIONAL_CMD DOWNLOAD
/end PROTOCOL_LAYER
/begin XCP_ON_CAN
0x0100
CAN_ID_MASTER 0x700
CAN_ID_SLAVE 0x701
BAUDRATE 500000
/end XCP_ON_CAN
/end IF_DATA
/end MODULE
/end PROJECT
